@model ITShop.ViewModels.BackOfficeProfileViewModel
@{
    Layout = "_AdminLayout";

    string GetStatusBadgeClass(string? status)
    {
        return (status ?? string.Empty).ToLower() switch
        {
            "delivered" => "bg-success-subtle text-success",
            "shipped" => "bg-success-subtle text-success",
            "paid" => "bg-primary-subtle text-primary",
            "packed" => "bg-info-subtle text-info",
            "processing" => "bg-warning-subtle text-warning",
            "pending" => "bg-warning-subtle text-warning",
            "cancelled" => "bg-danger-subtle text-danger",
            _ => "bg-secondary-subtle text-secondary"
        };
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Customer Profile</h2>
        </div>
        <a asp-action="Userlist" class="btn btn-outline-secondary">Back to Customer List</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center fw-bold mb-3" style="width: 88px; height: 88px; font-size: 1.75rem;">
                        @Model.AvatarInitials
                    </div>
                    <h3 class="h5 mb-1">@Model.Profile.FirstName @Model.Profile.LastName</h3>
                    <p class="text-muted small mb-2">@Model.Profile.Email</p>
                    <span class="badge bg-light text-dark text-uppercase">@(string.IsNullOrWhiteSpace(Model.Profile.Status) ? "active" : Model.Profile.Status)</span>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <div class="small text-muted mb-2">Phone</div>
                    <div class="fw-semibold mb-3">@(string.IsNullOrWhiteSpace(Model.Profile.PhoneNumber) ? "-" : Model.Profile.PhoneNumber)</div>
                    <div class="small text-muted mb-2">Roles</div>
                    <div>
                        @foreach (var role in Model.Profile.Roles)
                        {
                            <span class="badge bg-secondary-subtle text-secondary me-1">@role</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
                        <div>
                            <h3 class="h4 mb-2">@Model.Profile.FirstName's dashboard</h3>
                            <div class="fw-semibold">@Model.Profile.CreatedAt?.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="text-lg-end">
                                <div class="text-muted small mb-1">Default Address</div>
                            <div class="fw-semibold">@Model.DefaultAddressPreview</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3 col-6"><div class="border rounded-3 p-3 h-100 bg-light-subtle"><div class="text-muted small">Total Orders</div><div class="fs-4 fw-bold">@Model.TotalOrders</div></div></div>
                        <div class="col-md-3 col-6"><div class="border rounded-3 p-3 h-100 bg-light-subtle"><div class="text-muted small">Active Orders</div><div class="fs-4 fw-bold">@Model.ActiveOrders</div></div></div>
                        <div class="col-md-3 col-6"><div class="border rounded-3 p-3 h-100 bg-light-subtle"><div class="text-muted small">Saved Addresses</div><div class="fs-4 fw-bold">@Model.AddressCount</div></div></div>
                        <div class="col-md-3 col-6"><div class="border rounded-3 p-3 h-100 bg-light-subtle"><div class="text-muted small">Lifetime Spend</div><div class="fs-5 fw-bold">@Model.LifetimeSpent.ToString("N2") บาท</div></div></div>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h4 mb-0">Recent Orders</h3>
                    </div>

                    @if (!Model.RecentOrders.Any())
                    {
                        <div class="alert alert-light border mb-0">ยังไม่มีประวัติคำสั่งซื้อ</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var order in Model.RecentOrders)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 h-100 bg-light-subtle">
                                        <div class="d-flex justify-content-between gap-2 mb-2">
                                            <div>
                                                <div class="fw-semibold">@order.OrderNumber</div>
                                                <div class="small text-muted">@order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                            <span class="badge @GetStatusBadgeClass(order.Status)">@order.Status</span>
                                        </div>
                                        <div class="small mb-2">@order.ItemSummary</div>
                                        <div class="small text-muted">@order.ItemCount item(s)</div>
                                        <div class="fw-semibold mt-2">@order.FinalAmount.ToString("N2") บาท</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3 class="h4 mb-0">Available Coupons</h3>
                            </div>

                            @if (!Model.AvailableCoupons.Any())
                            {
                                <div class="alert alert-light border mb-0">ตอนนี้ยังไม่มีคูปองที่พร้อมใช้งาน</div>
                            }
                            else
                            {
                                @foreach (var coupon in Model.AvailableCoupons.Take(6))
                                {
                                    <div class="border rounded-3 p-3 bg-light-subtle mb-3">
                                        <div class="d-flex justify-content-between gap-2 align-items-start mb-2">
                                            <div>
                                                <div class="fw-semibold">@coupon.Code</div>
                                                <div class="small text-muted">@coupon.PromotionName</div>
                                            </div>
                                            <span class="badge text-bg-success">@coupon.DiscountLabel</span>
                                        </div>
                                        <div class="small text-muted">@coupon.ApplicableProductSummary</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3 class="h4 mb-0">Coupon History</h3>
                            </div>

                            @if (!Model.CouponHistory.Any())
                            {
                                <div class="alert alert-light border mb-0">ยังไม่มีประวัติการใช้คูปอง</div>
                            }
                            else
                            {
                                @foreach (var item in Model.CouponHistory.Take(6))
                                {
                                    <div class="border rounded-3 p-3 bg-light-subtle mb-3">
                                        <div class="fw-semibold">@item.Code</div>
                                        <div class="small text-muted">@item.PromotionName</div>
                                        <div class="small">@item.OrderNumber</div>
                                        <div class="small text-muted">@item.UsedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h4 mb-0">Referral History</h3>
                    </div>

                    @if (!Model.ReferralHistory.Any())
                    {
                        <div class="alert alert-light border mb-0">ยังไม่มี referral history</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var invite in Model.ReferralHistory)
                            {
                                <div class="col-12">
                                    <div class="border rounded-3 p-3 h-100 bg-light-subtle">
                                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                                            <div>
                                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(invite.InvitedEmail) ? "Unknown referral" : invite.InvitedEmail)</div>
                                                <div class="small text-muted">สมัครเมื่อ @invite.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                            <span class="badge bg-light text-dark text-uppercase">@invite.Status</span>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-md-4"><div class="small text-muted">Invite Code</div><div class="fw-semibold">@invite.InviteCode</div></div>
                                            <div class="col-md-4"><div class="small text-muted">Promotion</div><div class="fw-semibold">@invite.PromotionName</div></div>
                                            <div class="col-md-4"><div class="small text-muted">Reward</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(invite.RewardCouponCode) ? "รอ order แรก" : invite.RewardCouponCode)</div></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>