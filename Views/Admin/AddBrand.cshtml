@model ITShop.ViewModels.BrandViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-4">Add Brand</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="AddBrand" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3" style="max-width: 480px;">
                    <label asp-for="BrandName" class="form-label">Brand Name</label>
                    <input asp-for="BrandName" class="form-control" />
                </div>

                <div class="mb-3" style="max-width: 480px;">
                    <label asp-for="LogoFile" class="form-label">Brand Logo</label>
                    <input asp-for="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Brand</button>
                    <a asp-action="BrandList" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>