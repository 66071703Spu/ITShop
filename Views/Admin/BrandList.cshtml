@model IEnumerable<ITShop.ViewModels.BrandViewModel>
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="admin-page-header">
        <h2 class="admin-page-title">Brand Management</h2>
        <a asp-action="AddBrand" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Brand</a>
    </div>

    @if (TempData["BrandSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["BrandSuccess"]</div>
    }

    @if (TempData["BrandError"] != null)
    {
        <div class="alert alert-danger">@TempData["BrandError"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">ยังไม่มีแบรนด์ในระบบ</div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Logo</th>
                                <th>Brand</th>
                                <th>Products</th>
                                <th>Sample Products</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var brand in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(brand.LogoUrl ?? "https://placehold.co/120x60?text=Brand")"
                                             alt="@brand.BrandName" width="120" height="60" class="admin-media-thumb"
                                             style="object-fit:contain;" />
                                    </td>
                                    <td class="fw-semibold">@brand.BrandName</td>
                                    <td>@brand.ProductCount</td>
                                    <td>@brand.ProductSummary</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="EditBrand" asp-route-id="@brand.BrandId"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            <form asp-action="DeleteBrand" method="post" class="d-inline"
                                                  data-confirm-message="ลบแบรนด์นี้ใช่ไหม?">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@brand.BrandId" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>