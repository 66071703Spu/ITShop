@model ITShop.ViewModels.BrandViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-4">Edit Brand</h2>

            @if (TempData["BrandSuccess"] != null)
            {
                <div class="alert alert-success">@TempData["BrandSuccess"]</div>
            }

            @if (TempData["BrandError"] != null)
            {
                <div class="alert alert-danger">@TempData["BrandError"]</div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="mb-3">
                <img src="@(Model.LogoUrl ?? "https://placehold.co/160x80?text=Brand")" alt="@Model.BrandName"
                     width="160" height="80" class="rounded border bg-light" style="object-fit:contain;" />
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <form asp-action="DeleteBrandLogo" method="post" class="d-inline"
                      data-confirm-message="ลบโลโก้ของแบรนด์นี้ใช่ไหม?">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BrandId" />
                    <button type="submit" class="btn btn-outline-danger">Delete Logo</button>
                </form>
            </div>

            <form asp-action="EditBrand" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="BrandId" type="hidden" />

                <div class="mb-3" style="max-width: 480px;">
                    <label asp-for="BrandName" class="form-label">Brand Name</label>
                    <input asp-for="BrandName" class="form-control" />
                </div>

                <div class="mb-3" style="max-width: 480px;">
                    <label asp-for="LogoFile" class="form-label">Upload New Logo</label>
                    <input asp-for="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update Brand</button>
                    <a asp-action="BrandList" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>