@model ITShop.ViewModels.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="admin-page-header">
        <h2 class="admin-page-title">Dashboard</h2>
        <a asp-action="OrderList" class="btn btn-outline-primary">View Orders</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card admin-stat-card h-100">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="label">Total Users</div>
                    <div class="value">@Model.TotalUsers</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card admin-stat-card h-100">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="label">Total Products</div>
                    <div class="value">@Model.TotalProducts</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card admin-stat-card h-100">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="label">Total Orders</div>
                    <div class="value">@Model.TotalOrders</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card admin-stat-card h-100">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="label">Low Stock</div>
                    <div class="value text-danger">@Model.LowStockCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Recent Orders</h5>
                <a asp-action="OrderList" class="btn btn-sm btn-outline-primary">View All</a>
            </div>

            @if (Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order No.</th>
                                <th>Customer</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>@order.OrderNumber</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.TotalAmount.ToString("N2") บาท</td>
                                    <td>@order.Status</td>
                                    <td>@order.PaymentMethod (@order.PaymentStatus)</td>
                                    <td>@order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">ยังไม่มีรายการสั่งซื้อในระบบ</div>
            }
        </div>
    </div>
</div>
