<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperAdmin ITShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        :root {
            --admin-sidebar-bg: linear-gradient(180deg, #161c2f 0%, #232c45 100%);
            --admin-sidebar-text: #d7def0;
            --admin-sidebar-active: rgba(255, 255, 255, 0.14);
            --admin-border: #e7eaf3;
            --admin-shadow: 0 18px 45px rgba(31, 41, 64, 0.08);
        }

        body { margin: 0; background: linear-gradient(180deg, #f4f6fb 0%, #eef2f9 100%); color: #1f2940; }
        .sidebar { width: 256px; min-height: 100vh; position: fixed; inset: 0 auto 0 0; background: var(--admin-sidebar-bg); color: white; padding: 24px 18px; box-shadow: 12px 0 40px rgba(9, 14, 28, 0.12); overflow-y: auto; }
        .sidebar a { display: flex; align-items: center; gap: 10px; color: var(--admin-sidebar-text); padding: 12px 14px; border-radius: 12px; text-decoration: none; margin-bottom: 6px; font-weight: 500; transition: 0.18s ease; }
        .sidebar a:hover, .sidebar a.active { background: var(--admin-sidebar-active); color: white; transform: translateX(2px); }
        .content { margin-left: 256px; padding: 24px; }
        .topbar { background: rgba(22, 28, 47, 0.96); color: white; padding: 14px 18px; border-radius: 18px; box-shadow: var(--admin-shadow); }
        .topbar .role-pill { border: 1px solid rgba(255,255,255,.16); border-radius: 999px; padding: 8px 12px; background: rgba(255,255,255,.06); }
        .card { border-radius: 20px; border-color: var(--admin-border) !important; box-shadow: var(--admin-shadow) !important; }
        .card .card-body { padding: 1.5rem; }
        .table-responsive { border-radius: 18px; }
        .table { --bs-table-bg: transparent; margin-bottom: 0; }
        .table thead th { border-bottom-width: 1px; color: #6c7891; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; padding-top: 1rem; padding-bottom: 1rem; }
        .table tbody td { padding-top: 1rem; padding-bottom: 1rem; vertical-align: middle; }
        .form-control, .form-select { min-height: 46px; border-radius: 14px; border-color: var(--admin-border); }
        textarea.form-control { min-height: 120px; }
        .btn { border-radius: 12px; font-weight: 600; }
        .badge { border-radius: 999px; padding: 0.5em 0.75em; }
        .admin-page-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
        .admin-page-title { margin: 0; font-weight: 700; }
        .admin-stat-card .label { color: #6c7891; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 700; }
        .admin-stat-card .value { font-size: 2rem; font-weight: 700; line-height: 1.1; }
        .admin-media-thumb { border-radius: 16px; border: 1px solid var(--admin-border); background: #f7f8fc; }
        .admin-form-shell { max-width: 1120px; margin: 0 auto; }
        .admin-form-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
        .admin-form-title-wrap { display: flex; align-items: center; gap: 1rem; }
        .admin-icon-badge { width: 52px; height: 52px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.25rem; flex: 0 0 52px; }
        .admin-form-kicker { color: #6c7891; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.25rem; }
        .admin-form-title { margin: 0; font-weight: 700; }
        .admin-section-card { border: 1px solid var(--admin-border); border-radius: 18px; background: #f7f8fc; padding: 1.25rem; height: 100%; }
        .admin-section-title { font-size: 0.95rem; font-weight: 700; margin-bottom: 1rem; }
        .admin-soft-panel { border: 1px solid var(--admin-border); border-radius: 16px; background: #ffffff; padding: 1rem; }
        .admin-action-row { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }
        .admin-compact-note { color: #6c7891; font-size: 0.85rem; }
        .admin-field-stack { display: grid; gap: 1rem; }
        .admin-choice-card { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.9rem 1rem; border: 1px solid var(--admin-border); border-radius: 14px; background: #fff; height: 100%; margin: 0; }
        .admin-choice-card .form-check-input { margin: 0.15rem 0 0; flex: 0 0 auto; }
        .admin-choice-card .choice-body { flex: 1 1 auto; min-width: 0; }

        @@media (max-width: 991.98px) {
            .sidebar { position: static; width: 100%; min-height: auto; border-radius: 0 0 20px 20px; }
            .content { margin-left: 0; padding: 18px; }
            .admin-page-header, .admin-form-header { flex-direction: column; align-items: stretch; }
            .admin-form-title-wrap { align-items: flex-start; }
        }
    </style>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    }
    <div class="sidebar">
        <h4 class="text-center mb-3">ITShop SuperAdmin</h4>
        <hr class="border-secondary" />
        <a asp-controller="SuperAdmin" asp-action="Dashboard" class="@((currentController == "SuperAdmin" && currentAction == "Dashboard") ? "active" : string.Empty)"><i class="bi bi-shield-lock"></i> Dashboard</a>
        <a asp-controller="SuperAdmin" asp-action="AdminList" class="@((currentController == "SuperAdmin" && (currentAction == "AdminList" || currentAction == "AdminProfile")) ? "active" : string.Empty)"><i class="bi bi-people-fill"></i> Admin Accounts</a>
        <a asp-controller="SuperAdmin" asp-action="Permissions" class="@((currentController == "SuperAdmin" && currentAction == "Permissions") ? "active" : string.Empty)"><i class="bi bi-key"></i> Permissions</a>
        <hr class="border-secondary" />
        <a asp-controller="Admin" asp-action="Dashboard" class="@((currentController == "Admin") ? "active" : string.Empty)"><i class="bi bi-grid"></i> Open Admin Area</a>
        <a asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
    <div class="content">
        @if (TempData["AdminError"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["AdminError"]</div>
        }
        <div class="topbar d-flex justify-content-between align-items-center mb-4">
            <span class="fw-semibold">SuperAdmin Console</span>
            <a asp-controller="SuperAdmin" asp-action="Profile" class="text-white text-decoration-none d-inline-flex align-items-center gap-2 role-pill">
                <i class="bi bi-person-badge"></i>
                <span>SUPERADMIN</span>
            </a>
        </div>
        <main role="main">@RenderBody()</main>
    </div>
    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="confirmActionModalLabel">Confirm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="mb-0" id="confirmActionModalMessage"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmActionModalSubmit">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>