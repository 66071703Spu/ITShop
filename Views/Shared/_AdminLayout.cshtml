@using ITShop.Helpers
@using Microsoft.EntityFrameworkCore
@inject ITShop.Models.Csi402dbContext Db

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin ITShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
            :root {
                --admin-sidebar-bg: linear-gradient(180deg, #161c2f 0%, #232c45 100%);
                --admin-sidebar-text: #d7def0;
                --admin-sidebar-active: rgba(255, 255, 255, 0.14);
                --admin-surface-soft: #f7f8fc;
                --admin-border: #e7eaf3;
                --admin-text: #1f2940;
                --admin-muted: #6c7891;
                --admin-shadow: 0 18px 45px rgba(31, 41, 64, 0.08);
            }

            body {
                margin: 0;
                background: linear-gradient(180deg, #f4f6fb 0%, #eef2f9 100%);
                color: var(--admin-text);
            }

            .sidebar {
                width: 256px;
                min-height: 100vh;
                position: fixed;
                inset: 0 auto 0 0;
                background: var(--admin-sidebar-bg);
                color: white;
                padding: 24px 18px;
                box-shadow: 12px 0 40px rgba(9, 14, 28, 0.12);
                overflow-y: auto;
            }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 18px;
                font-weight: 700;
                letter-spacing: 0.02em;
            }

            .sidebar hr {
                border-color: rgba(255, 255, 255, 0.12);
                margin: 18px 0;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--admin-sidebar-text);
                padding: 12px 14px;
                border-radius: 12px;
                text-decoration: none;
                margin-bottom: 6px;
                font-weight: 500;
                transition: 0.18s ease;
            }

            .sidebar a:hover,
            .sidebar a.active {
                background: var(--admin-sidebar-active);
                color: white;
                transform: translateX(2px);
            }

            .content {
                margin-left: 256px;
                padding: 24px;
            }

            .topbar {
                background: rgba(22, 28, 47, 0.96);
                padding: 14px 18px;
                color: white;
                border-radius: 18px;
                box-shadow: var(--admin-shadow);
            }

            .topbar .role-pill {
                border: 1px solid rgba(255, 255, 255, 0.16);
                border-radius: 999px;
                padding: 8px 12px;
                background: rgba(255, 255, 255, 0.06);
            }

            .card {
                border-radius: 20px;
                border-color: var(--admin-border) !important;
                box-shadow: var(--admin-shadow) !important;
            }

            .card .card-body {
                padding: 1.5rem;
            }

            .table-responsive {
                border-radius: 18px;
            }

            .table {
                --bs-table-bg: transparent;
                margin-bottom: 0;
            }

            .table thead th {
                border-bottom-width: 1px;
                color: var(--admin-muted);
                font-size: 0.82rem;
                font-weight: 700;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                padding-top: 1rem;
                padding-bottom: 1rem;
            }

            .table tbody td {
                padding-top: 1rem;
                padding-bottom: 1rem;
                vertical-align: middle;
            }

            .form-control,
            .form-select {
                min-height: 46px;
                border-radius: 14px;
                border-color: var(--admin-border);
            }

            textarea.form-control {
                min-height: 120px;
            }

            .btn {
                border-radius: 12px;
                font-weight: 600;
            }

            .badge {
                border-radius: 999px;
                padding: 0.5em 0.75em;
            }

            .admin-page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
                margin-bottom: 1.5rem;
            }

            .admin-page-title {
                margin: 0;
                font-weight: 700;
            }

            .admin-stat-card .label {
                color: var(--admin-muted);
                font-size: 0.82rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                font-weight: 700;
            }

            .admin-stat-card .value {
                font-size: 2rem;
                font-weight: 700;
                line-height: 1.1;
            }

            .admin-media-thumb {
                border-radius: 16px;
                border: 1px solid var(--admin-border);
                background: var(--admin-surface-soft);
            }

            .admin-form-shell {
                max-width: 1120px;
                margin: 0 auto;
            }

            .admin-form-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
                margin-bottom: 1.5rem;
            }

            .admin-form-title-wrap {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .admin-icon-badge {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
                flex: 0 0 52px;
            }

            .admin-form-kicker {
                color: var(--admin-muted);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                font-size: 0.75rem;
                font-weight: 700;
                margin-bottom: 0.25rem;
            }

            .admin-form-title {
                margin: 0;
                font-weight: 700;
            }

            .admin-section-card {
                border: 1px solid var(--admin-border);
                border-radius: 18px;
                background: var(--admin-surface-soft);
                padding: 1.25rem;
                height: 100%;
            }

            .admin-section-title {
                font-size: 0.95rem;
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .admin-soft-panel {
                border: 1px solid var(--admin-border);
                border-radius: 16px;
                background: #ffffff;
                padding: 1rem;
            }

            .admin-action-row {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                justify-content: flex-end;
                margin-top: 1.5rem;
            }

            .admin-compact-note {
                color: var(--admin-muted);
                font-size: 0.85rem;
            }

            .admin-field-stack {
                display: grid;
                gap: 1rem;
            }

            .admin-choice-card {
                display: flex;
                gap: 0.75rem;
                align-items: flex-start;
                padding: 0.9rem 1rem;
                border: 1px solid var(--admin-border);
                border-radius: 14px;
                background: #fff;
                height: 100%;
                margin: 0;
            }

            .admin-choice-card .form-check-input {
                margin: 0.15rem 0 0;
                flex: 0 0 auto;
            }

            .admin-choice-card .choice-body {
                flex: 1 1 auto;
                min-width: 0;
            }

            @@media (max-width: 991.98px) {
                .sidebar {
                    position: static;
                    width: 100%;
                    min-height: auto;
                    border-radius: 0 0 20px 20px;
                }

                .content {
                    margin-left: 0;
                    padding: 18px;
                }

                .admin-page-header {
                    flex-direction: column;
                    align-items: stretch;
                }

                .admin-form-header {
                    flex-direction: column;
                    align-items: stretch;
                }

                .admin-form-title-wrap {
                    align-items: flex-start;
                }
            }
    </style>
</head>

<body>
    @{
        var isSuperAdmin = (ViewBag.IsSuperAdmin as bool?) == true;
        var currentAdminRoleValue = ViewBag.CurrentAdminRole as string ?? "admin";
        var currentAdminRole = currentAdminRoleValue.ToUpperInvariant();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var grantedPermissions = isSuperAdmin
            ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            : Db.RolePermissions
                .Include(rp => rp.Role)
                .Include(rp => rp.Permission)
                .Where(rp => rp.Role != null && rp.Role.RoleName == currentAdminRoleValue && rp.Permission != null &&
    rp.Permission.PermissionName != null)
                .Select(rp => rp.Permission!.PermissionName!)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

        bool HasMenuPermission(string permissionName)
        {
            return isSuperAdmin || grantedPermissions.Contains(permissionName);
        }
    }

    <div class="sidebar">
        <h4>ITShop Admin</h4>

        <hr />

        @if (HasMenuPermission("dashboard.view"))
        {
            <a asp-controller="Admin" asp-action="Dashboard"
                   class="@((currentController == "Admin" && currentAction == "Dashboard") ? "active" : string.Empty)">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
        }

        @if (HasMenuPermission("products.manage"))
        {
            <a asp-controller="Admin" asp-action="ProductList"
                   class="@((currentController == "Admin" && (currentAction == "ProductList" || currentAction == "AddProduct" || currentAction == "EditProduct")) ? "active" : string.Empty)">
                <i class="bi bi-box"></i> Products
            </a>
        }

        @if (HasMenuPermission("stock.manage"))
        {
            <a asp-controller="Admin" asp-action="ManageStock"
                   class="@((currentController == "Admin" && currentAction == "ManageStock") ? "active" : string.Empty)">
                <i class="bi bi-patch-check"></i> Manage Stock
            </a>
        }

        @if (HasMenuPermission("banners.manage"))
        {
            <a asp-controller="Admin" asp-action="BannerList"
                   class="@((currentController == "Admin" && (currentAction == "BannerList" || currentAction == "AddBanner" || currentAction == "EditBanner")) ? "active" : string.Empty)">
                <i class="bi bi-image"></i> Banners
            </a>
        }

        @if (HasMenuPermission("promotions.manage"))
        {
            <a asp-controller="Admin" asp-action="PromotionList"
                   class="@((currentController == "Admin" && (currentAction == "PromotionList" || currentAction == "AddPromotion" || currentAction == "EditPromotion")) ? "active" : string.Empty)">
                <i class="bi bi-megaphone"></i> Promotions
            </a>
        }

        @if (HasMenuPermission("brands.manage"))
        {
            <a asp-controller="Admin" asp-action="BrandList"
                   class="@((currentController == "Admin" && (currentAction == "BrandList" || currentAction == "AddBrand" || currentAction == "EditBrand")) ? "active" : string.Empty)">
                <i class="bi bi-tags"></i> Brands
            </a>
        }

        @if (HasMenuPermission("orders.view"))
        {
            <a asp-controller="Admin" asp-action="OrderList"
                   class="@((currentController == "Admin" && (currentAction == "OrderList" || currentAction == "EditShipment")) ? "active" : string.Empty)">
                <i class="bi bi-receipt"></i> Orders
            </a>
        }

        @if (HasMenuPermission("customers.manage"))
        {
            <a asp-controller="Admin" asp-action="UserList"
                   class="@((currentController == "Admin" && (currentAction == "UserList" || currentAction == "Useredit" || currentAction == "AddUser" || currentAction == "CustomerProfile")) ? "active" : string.Empty)">
                <i class="bi bi-people"></i> Customers
            </a>
        }

        @if (isSuperAdmin)
        {
            <a asp-controller="SuperAdmin" asp-action="Dashboard"
                   class="@((currentController == "SuperAdmin") ? "active" : string.Empty)">
                <i class="bi bi-shield-lock"></i> SuperAdmin Console
            </a>
        }

        <hr />

        <a asp-controller="Account" asp-action="Logout">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>

    <div class="content">
        @if (TempData["AdminError"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["AdminError"]</div>
        }

        <div class="topbar d-flex justify-content-between align-items-center mb-4">
            <span class="fw-semibold">Admin Panel</span>

            <a asp-controller="@(isSuperAdmin ? "SuperAdmin" : "Admin")" asp-action="Profile"
                   class="text-white text-decoration-none d-inline-flex align-items-center gap-2 role-pill">
                <i class="bi bi-person-circle"></i>
                <span>@currentAdminRole</span>
            </a>
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="confirmActionModalLabel">Confirm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="mb-0" id="confirmActionModalMessage"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmActionModalSubmit">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>