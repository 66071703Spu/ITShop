@model ITShop.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <div class="auth-card row g-0" style="max-width: 720px;">
        <div class="auth-form-wrap">
            <h3 class="mb-3">ตั้งรหัสผ่านใหม่</h3>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">รหัสผ่านใหม่</label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่านใหม่</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary auth-action">บันทึกรหัสผ่าน</button>
            </form>
        </div>
    </div>
</div>
