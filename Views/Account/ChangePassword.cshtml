@model ITShop.ViewModels.ChangePasswordViewModel
@{
    Layout = "_UserLayout";
}

<div class="container py-4" style="max-width: 860px;">
    <div class="user-page-header">
        <div>
            <h2 class="user-page-title h3 mb-1">Change Password</h2>
            <p class="text-muted mb-0">เปลี่ยนรหัสผ่านของบัญชีที่กำลังล็อกอินอยู่</p>
        </div>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Back</a>
    </div>

    <div class="card border-0">
        <div class="card-body p-4">
            <form asp-controller="Account" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="user-section-card mb-4">
                    <div class="user-section-title">Security</div>
                    <div class="user-compact-note mb-0">ตั้งรหัสผ่านใหม่เพื่อใช้งานบัญชีของคุณต่ออย่างปลอดภัย</div>
                </div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}