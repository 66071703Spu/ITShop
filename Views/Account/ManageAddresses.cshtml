@model ITShop.ViewModels.ManageAddressesViewModel
@{
    Layout = "_UserLayout";
}

<div class="container py-4">
    <div class="user-page-header">
        <div>
            <h2 class="user-page-title h3 mb-1">Manage Addresses</h2>
            <p class="text-muted mb-0">จัดการที่อยู่สำหรับการจัดส่งแยกจากหน้า dashboard</p>
        </div>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["AddressSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["AddressSuccess"]</div>
    }

    @if (TempData["AddressError"] != null)
    {
        <div class="alert alert-danger">@TempData["AddressError"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0">
                <div class="card-body p-4">
                    <h3 class="h5 mb-3">Saved Addresses</h3>

                    @if (!Model.Addresses.Any())
                    {
                        <div class="alert alert-info mb-0">ยังไม่มีที่อยู่จัดส่ง</div>
                    }
                    else
                    {
                        <div class="d-grid gap-3">
                            @foreach (var address in Model.Addresses)
                            {
                                <div class="user-soft-panel">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="fw-semibold mb-1">
                                                @address.AddressLine
                                                @if (address.IsDefault)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary ms-2">Default</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 flex-wrap justify-content-end">
                                            @if (!address.IsDefault)
                                            {
                                                <form asp-controller="Account" asp-action="SetDefaultAddress" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@address.AddressId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Set
                                                        Default</button>
                                                    </form>
                                                }
                                                <form asp-controller="Account" asp-action="DeleteAddress" method="post"
                                                      onsubmit="return confirm('Delete this address?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@address.AddressId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0">
                    <div class="card-body p-4">
                        <h3 class="h5 mb-3">Add New Address</h3>

                        <form asp-controller="Account" asp-action="AddAddress" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="NewAddress.AddressLine" class="form-label">Address</label>
                                <textarea asp-for="NewAddress.AddressLine" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="NewAddress.AddressLine" class="text-danger"></span>
                            </div>
                            <div class="form-check mt-3">
                                <input asp-for="NewAddress.IsDefault" class="form-check-input" />
                                <label asp-for="NewAddress.IsDefault" class="form-check-label">Set as default
                                    address</label>
                                </div>

                                <button type="submit" class="btn btn-primary mt-4">Save Address</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }