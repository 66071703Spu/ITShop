@model ITShop.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <div class="auth-card row g-0" style="max-width: 980px;">
        <div class="col-lg-5 d-none d-lg-block">
            <div class="auth-side d-flex flex-column justify-content-between">
                <div>
                    <div class="small text-uppercase fw-bold mb-3">Recovery</div>
                    <h2 class="auth-title mb-3">Reset your password and get back to your account.</h2>
                    <p class="mb-0 opacity-75">กรอกอีเมลของบัญชีและตั้งรหัสผ่านใหม่ให้พร้อมใช้งานต่อทันที</p>
                </div>
                <div class="small opacity-75">ITShop account recovery</div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="auth-form-wrap">
                <div class="mb-4">
                    <div class="text-uppercase small fw-bold text-muted mb-2">Account</div>
                    <h3 class="mb-1">Forgot Password</h3>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control"
                               placeholder="Enter new password" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                               placeholder="Confirm new password" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary auth-action">Reset Password</button>
                    </div>
                </form>

                <div class="mt-4 text-center user-compact-note">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
