@model ITShop.ViewModels.RolePermissionMatrixViewModel
@{ Layout = "_SuperAdminLayout"; }

<style>
    .permission-card .card-body {
        padding: 1.5rem;
    }

    .permission-grid {
        display: grid;
        gap: 0.75rem;
    }

    .permission-option {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 58px;
        padding: 0.9rem 1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.9rem;
        background: #fff;
        margin: 0;
        cursor: pointer;
    }

    .permission-option .form-check-input {
        margin: 0;
        flex: 0 0 auto;
    }

    .permission-option-text {
        flex: 1 1 auto;
        line-height: 1.35;
    }
</style>

<div class="container-fluid py-2">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Role Permissions</h2>
        </div>
    </div>

    @if (TempData["PermissionSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["PermissionSuccess"]</div>
    }

    @if (!Model.Roles.Any())
    {
        <div class="alert alert-light border mb-0">ยังไม่มี role หลังบ้านที่ต้องตั้งค่าสิทธิ์จากหน้านี้</div>
    }
    else
    {
        <form asp-action="SaveRolePermissions" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-4">
                @for (var i = 0; i < Model.Roles.Count; i++)
                {
                    var role = Model.Roles[i];
                    var isSuperAdminRole = role.RoleName.ToLower() == "superadmin";

                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm border-0 h-100 permission-card">
                            <div class="card-body d-flex flex-column p-4">
                                <input type="hidden" name="Roles[@i].RoleId" value="@role.RoleId" />
                                <input type="hidden" name="Roles[@i].RoleName" value="@role.RoleName" />

                                <div class="d-flex justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                                    <h5 class="mb-0 text-capitalize">@role.RoleName</h5>
                                    @if (isSuperAdminRole)
                                    {
                                        <span class="badge bg-danger">Full Access</span>
                                    }
                                </div>

                                @if (role.AvailablePermissions.Any())
                                {
                                    <div class="permission-grid flex-grow-1">
                                        @foreach (var permission in role.AvailablePermissions)
                                        {
                                            var isChecked = role.SelectedPermissionIds.Contains(permission.PermissionId) || isSuperAdminRole;
                                            <label class="permission-option">
                                                <input class="form-check-input me-2"
                                                       type="checkbox"
                                                       name="Roles[@i].SelectedPermissionIds"
                                                       value="@permission.PermissionId"
                                                       @(isChecked ? "checked" : null)
                                                       @(isSuperAdminRole ? "disabled" : null) />
                                                <span class="permission-option-text">@permission.DisplayName</span>
                                            </label>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0 flex-grow-1">@role.EmptyStateMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="pt-4 d-flex justify-content-end">
                <button type="submit" class="btn btn-dark px-4">Save All Permissions</button>
            </div>
        </form>
    }
</div>