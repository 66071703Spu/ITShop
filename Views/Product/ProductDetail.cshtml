@model ITShop.ViewModels.ProductViewModel
@{
    Layout = "_UserLayout";
    var product = Model ?? new ITShop.ViewModels.ProductViewModel();
    var images = product.Images ?? new List<string>();
    var firstImage = images.FirstOrDefault() ?? "https://placehold.co/600x400?text=No+Image";
    var relatedProducts = product.RelatedProducts ?? new List<ITShop.ViewModels.ProductViewModel>();
    var availableStock = Math.Max(product.Stock ?? 0, 0);
    var isInStock = availableStock > 0;
    var skuText = string.IsNullOrWhiteSpace(product.Sku) ? "-" : product.Sku;
    var packageComponents = product.PackageComponents ?? new List<ITShop.ViewModels.PackageComponentViewModel>();
}

<div class="container py-3">
    <div class="row g-4">
        <div class="col-md-6">
            <img id="mainImage" src="@firstImage" alt="@product.Name" class="img-fluid user-media-thumb mb-3 p-3"
                 style="width:100%; max-height:420px; object-fit:contain;">

            @if (string.Equals(firstImage, "/images/comset-starter-kit.png", StringComparison.OrdinalIgnoreCase))
            {
                <p class="small text-muted mb-2">ภาพประกอบสินค้าในเซต ดูรุ่นจริงของแต่ละชิ้นในรายการด้านล่าง</p>
            }

            <div class="d-flex gap-2 flex-wrap">
                @foreach (var img in images)
                {
                    <img src="@img" alt="@product.Name" class="img-thumbnail user-media-thumb"
                         style="width:80px; height:80px; object-fit:cover; cursor:pointer;" onclick="changeImage('@img')" />
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="user-kicker">Product Detail</div>
            <h3 class="fw-bold">@product.Name</h3>
            <p class="text-muted mb-1">Category: @(string.IsNullOrWhiteSpace(product.CategoryName) ? "ทั่วไป" :
                                product.CategoryName)</p>
                @if (!string.IsNullOrWhiteSpace(product.BrandName))
                {
                    <p class="text-muted mb-1">Brand: @product.BrandName</p>
                }
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge @(isInStock ? "text-bg-success" : "text-bg-secondary")">@(isInStock ? "In Stock" :
                          "Out of Stock")</span>
                        <span class="badge text-bg-light">SKU: @skuText</span>
                        @if (product.IsPackageProduct)
                        {
                            <span class="badge text-bg-primary">Comset</span>
                            @if (product.PackageItemCount > 0)
                            {
                                <span class="badge text-bg-info">@product.PackageItemCount ชิ้นในเซต</span>
                            }
                        }
                    </div>
                    <p class="text-muted mb-3">Available: @(product.Stock ?? 0) ชิ้น</p>

                    @if (product.IsPackageProduct)
                    {
                        <div class="alert @(product.HasUnavailablePackageItems ? "alert-warning" : "alert-info") py-2">
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(product.PackageName) ? "Comset" :
                                                    product.PackageName)</div>
                                <div class="small mb-0">
                                    @if (packageComponents.Any())
                                    {
                                        <span>เซตนี้มีทั้งหมด @product.PackageItemCount ชิ้น และสามารถกดดูรายละเอียดสินค้ารายชิ้นได้</span>
                                    }
                                    else
                                    {
                                        <span>เซตนี้ยังไม่มีรายการสินค้าที่ผูกไว้ในระบบ</span>
                                    }
                                    @if (product.HasUnavailablePackageItems)
                                    {
                                        <span class="d-block text-danger">เซตนี้ยังสั่งซื้อไม่ได้ เพราะมีชิ้นส่วนไม่พร้อมขาย</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (product.HasAutoAppliedPromotion)
                        {
                            <div class="mb-3">
                                <div class="d-flex flex-wrap align-items-end gap-2">
                                    <div class="display-6 fw-bold text-danger lh-1 mb-0">฿@product.Price.ToString("N2")</div>
                                    <div class="fs-5 text-secondary text-decoration-line-through mb-1">
                                        ฿@product.OriginalPrice.ToString("N2")</div>
                                        @if (!string.IsNullOrWhiteSpace(product.DiscountLabel))
                                        {
                                            <span class="badge text-bg-danger mb-1">@product.DiscountLabel</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(product.ActivePromotionName))
                                    {
                                        <div class="small text-success mt-1">Auto Apply Promotion: @product.ActivePromotionName</div>
                                    }
                                </div>
                            }
            else
                            {
                                <div class="display-6 fw-bold text-danger mb-3">฿@product.Price.ToString("N2")</div>
                            }

                            <hr />

                            @if (product.AvailableCoupons.Any())
                            {
                                <div class="mb-4">
                                    <h5 class="mb-3">Available Coupons</h5>
                                    <div class="d-grid gap-2">
                                        @foreach (var coupon in product.AvailableCoupons.Take(3))
                                        {
                                            <div class="user-soft-panel">
                                                <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                                                    <div>
                                                        <div class="fw-semibold">@coupon.Code</div>
                                                        <div class="small text-muted">@coupon.PromotionName</div>
                                                    </div>
                                                    <span class="badge text-bg-success">@coupon.DiscountLabel</span>
                                                </div>
                                                <div class="small text-muted mt-2">@coupon.ApplicableProductSummary</div>
                                                @if (coupon.MinimumOrderSubtotal.HasValue)
                                                {
                                                    <div class="small text-muted">ขั้นต่ำ @coupon.MinimumOrderSubtotal.Value.ToString("N2") บาท
                                                    </div>
                                                }
                                                <div class="small @(coupon.IsCurrentlyEligible ? "text-success" : "text-warning") mt-1">
                                                    @coupon.EligibilityMessage</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="d-flex align-items-center mb-3">
                                    <button type="button" id="decreaseQtyButton" class="btn btn-outline-secondary" onclick="decrease()" @(isInStock ? null :
                                                                                                                                                "disabled")>-</button>
                                    <input id="qty" type="text" value="01" class="form-control mx-2 text-center" style="width:80px;"
                                           readonly />
                                    <button type="button" id="increaseQtyButton" class="btn btn-outline-secondary" onclick="increase()" @(isInStock ? null :
                                                                                                                                               "disabled")>+</button>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.ProductId" />
                                            <input type="hidden" name="productName" value="@product.Name" />
                                            <input type="hidden" name="price" value="@product.Price" />
                                            <input type="hidden" name="imageUrl" value="@firstImage" />
                                            <input type="hidden" id="hiddenQtyCart" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-warning w-100" disabled="@(!isInStock)">Add to
                                                Cart</button>
                                            </form>
                                        </div>
                                        <div class="col-6">
                                            <form asp-controller="Cart" asp-action="BuyNow" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                <input type="hidden" name="productName" value="@product.Name" />
                                                <input type="hidden" name="price" value="@product.Price" />
                                                <input type="hidden" name="imageUrl" value="@firstImage" />
                                                <input type="hidden" id="hiddenQtyBuy" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-danger w-100" disabled="@(!isInStock)">Buy Now</button>
                                            </form>
                                        </div>
                                    </div>

                                    @if (!isInStock)
                                    {
                                        <div class="alert alert-secondary mt-3 mb-0">สินค้าหมดชั่วคราว ยังไม่สามารถสั่งซื้อได้</div>
                                    }
                                </div>

                                <div class="mt-5">
                                    <div class="user-section-card">
                                        <div class="user-section-title">Product Description</div>
                                        <p class="mb-0">@(string.IsNullOrWhiteSpace(product.Description) ? "ยังไม่มีรายละเอียดสินค้า" :
                                                                product.Description)</p>
                                        </div>
                                    </div>

                                    @if (product.IsPackageProduct)
                                    {
                                        <div class="mt-5">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h4 class="mb-0">สินค้าในเซต</h4>
                                                @if (packageComponents.Any())
                                                {
                                                    <span class="text-muted small">กดเพื่อดูหน้าสินค้ารายชิ้นได้</span>
                                                }
                                            </div>

                                            @if (!packageComponents.Any())
                                            {
                                                <div class="alert alert-light border mb-0">เซตนี้ยังไม่มีรายการสินค้าที่เชื่อมไว้</div>
                                            }
                                            else
                                            {
                                                <div class="row g-3">
                                                    @foreach (var component in packageComponents)
                                                    {
                                                        <div class="col-12 col-md-6 col-xl-4">
                                                            @if (component.CanOpenProduct)
                                                            {
                                                                <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@component.ProductId"
                                                                       class="text-decoration-none text-dark">
                                                                    <div class="card user-product-card h-100 shadow-sm border-0">
                                                                        <img src="@(component.ImageUrl ?? "https://placehold.co/300x300?text=No+Image")"
                                                                             class="card-img-top p-3 user-media-thumb" style="height:180px; object-fit:contain;" />
                                                                        <div class="card-body">
                                                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                                                <span
                                                                                    class="badge bg-light text-dark">@(string.IsNullOrWhiteSpace(component.CategoryName)
                                                                                                                            ? "ทั่วไป" : component.CategoryName)</span>
                                                                                    <span
                                                                                    class="badge @(component.IsOutOfStock ? "text-bg-warning" : "text-bg-success")">@component.AvailabilityLabel</span>
                                                                                </div>
                                                                                <h6 class="card-title mb-1">@component.Name</h6>
                                                                                <div class="small text-muted mb-2">จำนวนในเซต: @component.Quantity</div>
                                                                                <p class="small text-muted mb-0">@component.Description</p>
                                                                            </div>
                                                                        </div>
                                                                    </a>
                                                                }
                                else
                                                                {
                                                                    <div class="card h-100 shadow-sm border-0 border-secondary-subtle">
                                                                        <img src="@(component.ImageUrl ?? "https://placehold.co/300x300?text=No+Product")"
                                                                             class="card-img-top p-3 user-media-thumb" style="height:180px; object-fit:contain;" />
                                                                        <div class="card-body">
                                                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                                                <span class="badge bg-light text-dark">ไม่มีรายการ</span>
                                                                                <span class="badge text-bg-secondary">@component.AvailabilityLabel</span>
                                                                            </div>
                                                                            <h6 class="card-title mb-1">@component.Name</h6>
                                                                            <div class="small text-muted mb-2">จำนวนในเซต: @component.Quantity</div>
                                                                            <p class="small text-muted mb-0">@component.Description</p>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="mt-5">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h4 class="mb-0">Related Products</h4>
                                                @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                                {
                                                    <a asp-controller="Product" asp-action="Index" asp-route-category="@product.CategoryName"
                                                       class="text-decoration-none">ดูทั้งหมด →</a>
                                                }
                                            </div>

                                            @if (!relatedProducts.Any())
                                            {
                                                <div class="alert alert-light border">ยังไม่มีสินค้าที่เกี่ยวข้อง</div>
                                            }
                                            else
                                            {
                                                <div class="row g-3">
                                                    @foreach (var item in relatedProducts)
                                                    {
                                                        <div class="col-6 col-md-3">
                                                            <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@item.ProductId"
                                                                   class="text-decoration-none text-dark">
                                                                <div class="card user-product-card h-100 shadow-sm border-0">
                                                                    <img src="@(item.ImageUrl ?? item.Images?.FirstOrDefault() ?? "https://placehold.co/300x300?text=No+Image")"
                                                                         class="card-img-top p-3 user-media-thumb" style="height:180px; object-fit:contain;" />
                                                                    <div class="card-body">
                                                                        <span class="badge bg-light text-dark mb-2">@(item.CategoryName ?? "ทั่วไป")</span>
                                                                        <h6 class="card-title mb-1">@item.Name</h6>
                                                                        @if (item.HasAutoAppliedPromotion)
                                                                        {
                                                                            <div>
                                                                                <p class="fw-bold text-danger mb-0">@item.Price.ToString("N2") บาท</p>
                                                                                <div class="small text-muted text-decoration-line-through">
                                                                                    @item.OriginalPrice.ToString("N2") บาท</div>
                                                                                </div>
                                                                            }
                                        else
                                                                            {
                                                                                <p class="fw-bold text-danger mb-0">@item.Price.ToString("N2") บาท</p>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </a>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <script>
                                        function changeImage(src) {
                                            document.getElementById("mainImage").src = src;
                                        }

                                        const maxStock = @availableStock;

                                        function syncQuantity(value) {
                                            const qty = document.getElementById("qty");
                                            const hiddenCart = document.getElementById("hiddenQtyCart");
                                            const hiddenBuy = document.getElementById("hiddenQtyBuy");
                                            const increaseButton = document.getElementById("increaseQtyButton");
                                            const decreaseButton = document.getElementById("decreaseQtyButton");
                                            const normalizedValue = Math.max(1, Math.min(value, maxStock || 1));

                                            qty.value = normalizedValue.toString().padStart(2, '0');
                                            hiddenCart.value = normalizedValue;
                                            hiddenBuy.value = normalizedValue;

                                            if (increaseButton) {
                                                increaseButton.disabled = maxStock <= 0 || normalizedValue >= maxStock;
                                            }

                                            if (decreaseButton) {
                                                decreaseButton.disabled = normalizedValue <= 1;
                                            }
                                        }

                                        function increase() {
                                            if (maxStock <= 0) {
                                                return;
                                            }

                                            const qty = document.getElementById("qty");
                                            const value = parseInt(qty.value, 10) || 1;
                                            syncQuantity(value + 1);
                                        }

                                        function decrease() {
                                            const qty = document.getElementById("qty");
                                            const value = parseInt(qty.value, 10) || 1;
                                            syncQuantity(value - 1);
                                        }

                                        syncQuantity(1);
                                    </script>
